# Project root inside the container
PROJECT_ROOT=/app

# Dataset (only needed if training runs inside Docker)
DATASET_DIR=logs
DATASET_NAME=insurance.csv 

# Saved model
MODEL_DIR=models
MODEL_NAME=insurance.pk1

# Logging
LOG_DIR=logs
LOG_NAME=project_log

# Training parameters
TARGET_COL=charges
TEST_SIZE=0.2
RANDOM_STATE=42

# Frontend → Backend communication
API_URL=http://backend:8000/predict